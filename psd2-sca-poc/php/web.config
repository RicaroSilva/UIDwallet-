<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deploy to the app's root on the server (httpdocs\uidwallettest\web.config)
  so it cascades to every subfolder, instead of needing a copy inside each
  extensionless ".well-known" folder individually (see well-known/web.config
  for why extensionless files need this at all).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension="." mimeType="application/json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
