<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS returns a plain 404 for extensionless files (openid-credential-issuer,
  oauth-authorization-server) unless a MIME type is mapped for them.
  fileExtension="." is IIS's convention for "no extension".
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension="." mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
