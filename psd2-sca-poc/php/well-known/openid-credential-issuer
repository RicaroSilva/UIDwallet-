{
  "credential_issuer": "https://pay.lusopay.com",
  "credential_endpoint": "https://pay.lusopay.com/uidwallettest/api/credential.php",
  "credential_configurations_supported": {
    "lusopay-card": {
      "format": "dc+sd-jwt",
      "vct": "urn:lusopay:card:1",
      "cryptographic_binding_methods_supported": ["jwk"],
      "credential_signing_alg_values_supported": ["ES256"],
      "proof_types_supported": {
        "jwt": {
          "proof_signing_alg_values_supported": ["ES256"]
        }
      },
      "display": [
        {
          "name": "LusoPay Card",
          "locale": "pt",
          "text_color": "#ffffff",
          "background_color": "#6d28d9"
        }
      ],
      "claims": [
        { "path": ["name"], "display": [{ "name": "Nome", "locale": "pt" }] },
        { "path": ["lusopay_id"], "display": [{ "name": "LusoPay ID", "locale": "pt" }] }
      ]
    }
  }
}
